<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="#0D1827">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="G.R.A.C.E. lighting" android:textColor="#55E8FF" android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="6dp" />
    <Button android:id="@+id/preset_bedtime" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bedtime" />
    <Button android:id="@+id/preset_wind_down" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wind down" />
    <Button android:id="@+id/preset_movie_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Movie time" />
    <Button android:id="@+id/preset_getting_home" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Getting home" />
</LinearLayout>
